{
  "manifest_version": 3,
  "name": "mySecondTeacher Annotation Helper",
  "version": "1.4.0",
  "description": "Custom keyboard shortcuts, Deadline Mode, and Timing Manager for audio annotations on mySecondTeacher Publishing.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "mySecondTeacher Annotation Helper",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://publishing.mysecondteacher.com/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "scripts": ["background/background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://publishing.mysecondteacher.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "annotation-helper@mysecondteacher.com",
      "strict_min_version": "109.0"
    }
  }
}
